    "] + [\n",
    "    {\"seed\": \"range\", \"exact_match\": f\"{(max(scores)-min(scores))*100:.1f} pp\"},\n",
    "    {\"seed\": \"range\", \"exact_match\": f\"{max(scores)-min(scores)*100:.1f} pp\"},\n",
    "])\n",
    "print(f\"Spread across seeds: {(max(scores)-min(scores))*len(test_examples):.0f} \"\n",
    "      f\"of {len(test_examples)} test examples\")\n",
    "variance_df"
